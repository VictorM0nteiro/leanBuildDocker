# Do not edit manually — re-run lbd to regenerate.

FROM {{ .BuildStage.BaseImage }} AS builder
{{- if .BuildStage.SystemPackages }}
{{- if eq .BuildStage.PackageManager "apk" }}
RUN apk add --no-cache {{ join .BuildStage.SystemPackages " " }}
{{- else }}
RUN apt-get update \
    && apt-get install -y --no-install-recommends {{ join .BuildStage.SystemPackages " " }} \
    && rm -rf /var/lib/apt/lists/*
{{- end }}
{{- end }}
WORKDIR /src
{{- if .IsWorkspace }}
COPY . .
{{- if .UseCacheMounts }}
RUN --mount=type=cache,target=/go/pkg/mod go mod download
{{- else }}
RUN go mod download
{{- end }}
{{- else }}
COPY go.mod go.sum* ./
{{- if .UseCacheMounts }}
RUN --mount=type=cache,target=/go/pkg/mod go mod download
{{- else }}
RUN go mod download
{{- end }}
COPY . .
{{- end }}
{{- if .BuildStage.CopyVendor }}
COPY vendor/ ./vendor/
{{- end }}
{{- if .BuildStage.VersionArg }}
ARG VERSION={{ .BuildStage.VersionArg }}
{{- end }}
{{- if .UseCacheMounts }}
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    {{ shellJoin .BuildStage.BuildCommand }}
{{- else }}
RUN {{ shellJoin .BuildStage.BuildCommand }}
{{- end }}

FROM {{ .RuntimeStage.BaseImage }}
{{- if .RuntimeStage.WorkingDir }}
WORKDIR {{ .RuntimeStage.WorkingDir }}
{{- end }}
COPY --from=builder /out/{{ .BinaryName }} {{ .BinaryPath }}
{{- range .RuntimeStage.Assets }}
COPY --from=builder /src/{{ .Src }} {{ .Dst }}
{{- end }}
{{- range .RuntimeStage.Env }}
ENV {{ .Key }}={{ .Value }}
{{- end }}
{{- if .RuntimeStage.User }}
USER {{ .RuntimeStage.User }}
{{- end }}
{{- range .RuntimeStage.ExposedPorts }}
EXPOSE {{ . }}
{{- end }}
{{- if .RuntimeStage.HealthCheck }}
HEALTHCHECK --interval={{ .RuntimeStage.HealthCheck.Interval }} --timeout={{ .RuntimeStage.HealthCheck.Timeout }} --retries={{ .RuntimeStage.HealthCheck.Retries }} CMD {{ execForm .RuntimeStage.HealthCheck.Test }}
{{- end }}
ENTRYPOINT {{ execForm .RuntimeStage.EntryCommand }}
