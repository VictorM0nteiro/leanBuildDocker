FROM {{ .BuildStage.BaseImage }} AS builder
{{- if .BuildStage.SystemPackages }}
{{- if eq .BuildStage.PackageManager "apk" }}
RUN apk add --no-cache {{ join .BuildStage.SystemPackages " " }}
{{- else }}
RUN apt-get update \
    && apt-get install -y --no-install-recommends {{ join .BuildStage.SystemPackages " " }} \
    && rm -rf /var/lib/apt/lists/*
{{- end }}
{{- end }}
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
{{- if .BuildStage.CopyVendor }}
COPY vendor/ ./vendor/
{{- end }}
RUN {{ execForm .BuildStage.BuildCommand }}

FROM {{ .RuntimeStage.BaseImage }}
{{- if .RuntimeStage.WorkingDir }}
WORKDIR {{ .RuntimeStage.WorkingDir }}
{{- end }}
COPY --from=builder /out/{{ .BinaryName }} {{ .BinaryPath }}
{{- if .RuntimeStage.User }}
USER {{ .RuntimeStage.User }}
{{- end }}
{{- range .RuntimeStage.ExposedPorts }}
EXPOSE {{ . }}
{{- end }}
ENTRYPOINT {{ execForm .RuntimeStage.EntryCommand }}
